{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "ThriftHaven Enterprise Design System Tokens",
  "version": "2.0.0",
  "description": "Multi-tier, enterprise-grade design token pipeline for ThriftHaven Circular Fashion Platform (Amazon DT Aesthetic Compliant).",
  "meta": {
    "author": "Antigravity UX Systems Architecture",
    "themeSupport": ["dark-default", "light-mode", "high-contrast-wcag-aaa"],
    "wcagCompliance": "2.1 AAA Level"
  },
  "tokens": {
    "primitive": {
      "color": {
        "navy": {
          "950": { "$value": "#030C1E", "$type": "color", "$description": "Deep Canvas Background (Amazon DT Dark Core)" },
          "900": { "$value": "#081632", "$type": "color", "$description": "Primary Container Surface" },
          "800": { "$value": "#0F172A", "$type": "color", "$description": "Card Elevated Surface" },
          "700": { "$value": "#1E293B", "$type": "color", "$description": "Border & Divider Accent" }
        },
        "gold": {
          "500": { "$value": "#F5A623", "$type": "color", "$description": "California Gold (Primary Accent)" },
          "400": { "$value": "#FFB84D", "$type": "color", "$description": "Hover Gold" },
          "600": { "$value": "#D48806", "$type": "color", "$description": "Active/Pressed Gold" }
        },
        "emerald": {
          "500": { "$value": "#10B981", "$type": "color", "$description": "Verified Sustainability Green" },
          "400": { "$value": "#34D399", "$type": "color", "$description": "Success Surface Accent" }
        },
        "cyan": {
          "400": { "$value": "#38BDF8", "$type": "color", "$description": "Tech Highlight Cyan" },
          "500": { "$value": "#0EA5E9", "$type": "color", "$description": "Focus Ring Glow" }
        },
        "crimson": {
          "500": { "$value": "#EF4444", "$type": "color", "$description": "Critical Defect/Low Capacity Red" }
        },
        "amber": {
          "500": { "$value": "#F59E0B", "$type": "color", "$description": "Medium Capacity Warning Yellow" }
        }
      },
      "fontFamily": {
        "mono": { "$value": "JetBrains Mono, monospace", "$type": "fontFamily" },
        "sans": { "$value": "Inter, sans-serif", "$type": "fontFamily" }
      },
      "spacing": {
        "1": { "$value": "4px", "$type": "dimension" },
        "2": { "$value": "8px", "$type": "dimension" },
        "3": { "$value": "12px", "$type": "dimension" },
        "4": { "$value": "16px", "$type": "dimension" },
        "6": { "$value": "24px", "$type": "dimension" },
        "8": { "$value": "32px", "$type": "dimension" },
        "12": { "$value": "48px", "$type": "dimension" }
      },
      "borderRadius": {
        "subtle": { "$value": "8px", "$type": "dimension", "$description": "Amazon DT Card Curve Standard" },
        "medium": { "$value": "12px", "$type": "dimension" },
        "pill": { "$value": "9999px", "$type": "dimension" }
      }
    },
    "semantic": {
      "color": {
        "surface": {
          "background": { "$value": "{primitive.color.navy.950}", "$type": "color" },
          "card": { "$value": "{primitive.color.navy.900}", "$type": "color" },
          "elevated": { "$value": "{primitive.color.navy.800}", "$type": "color" }
        },
        "border": {
          "default": { "$value": "{primitive.color.navy.700}", "$type": "color" },
          "accent": { "$value": "{primitive.color.gold.500}", "$type": "color" },
          "status": {
            "highCapacity": { "$value": "{primitive.color.emerald.500}", "$type": "color" },
            "mediumCapacity": { "$value": "{primitive.color.amber.500}", "$type": "color" },
            "lowCapacity": { "$value": "{primitive.color.crimson.500}", "$type": "color" }
          }
        },
        "text": {
          "primary": { "$value": "#F8FAFC", "$type": "color", "$description": "Contrast Ratio 15.2:1 against Canvas" },
          "secondary": { "$value": "#CBD5E1", "$type": "color", "$description": "Contrast Ratio 9.8:1" },
          "accent": { "$value": "{primitive.color.gold.500}", "$type": "color" },
          "codeHighlight": { "$value": "{primitive.color.cyan.400}", "$type": "color" }
        },
        "interactive": {
          "focusRing": { "$value": "{primitive.color.cyan.500}", "$type": "color" },
          "activeState": { "$value": "{primitive.color.gold.600}", "$type": "color" }
        }
      }
    },
    "component": {
      "button": {
        "primary": {
          "background": { "$value": "{semantic.color.border.accent}", "$type": "color" },
          "text": { "$value": "{primitive.color.navy.950}", "$type": "color" },
          "minHeight": { "$value": "48px", "$type": "dimension", "$description": "WCAG 2.1 AA Touch Target Minimum" },
          "paddingHorizontal": { "$value": "{primitive.spacing.6}", "$type": "dimension" }
        },
        "secondary": {
          "background": { "$value": "transparent", "$type": "color" },
          "border": { "$value": "{semantic.color.border.accent}", "$type": "color" },
          "text": { "$value": "{semantic.color.text.accent}", "$type": "color" }
        }
      },
      "cardGrid": {
        "borderColor": { "$value": "{semantic.color.border.default}", "$type": "color" },
        "borderRadius": { "$value": "{primitive.borderRadius.subtle}", "$type": "color" },
        "iconContainer": {
          "background": { "$value": "#FFFFFF", "$type": "color", "$description": "High contrast white circular background for monographic icons" },
          "shape": { "$value": "circle", "$type": "string" }
        }
      },
      "commitmentBanner": {
        "border": { "$value": "{primitive.color.gold.500}", "$type": "color" },
        "targetIcon": { "$value": "{primitive.color.gold.500}", "$type": "color" },
        "highlightWords": ["service excellence", "SLA performance", "business value"]
      }
    }
  }
}
